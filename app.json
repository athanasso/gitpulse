{
  "expo": {
    "name": "GitPulse",
    "slug": "gitpulse",
    "version": "1.4.0",
    "orientation": "portrait",
    "scheme": "gitpulse",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070B14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.athanasso.gitpulse"
    },
    "android": {
      "package": "com.athanasso.gitpulse",
      "versionCode": 16,
      "adaptiveIcon": {
        "backgroundColor": "#070B14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            { "scheme": "https", "host": "github.com" },
            { "scheme": "http", "host": "github.com" },
            { "scheme": "https", "host": "www.github.com" },
            { "scheme": "http", "host": "www.github.com" },
            { "scheme": "https", "host": "gitlab.com" },
            { "scheme": "https", "host": "www.gitlab.com" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}

